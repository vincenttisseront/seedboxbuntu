# =============================================================================
#  SeedBoxBuntu - variables de la stack                     /opt/seedbox/.env
#  Droits 0600 : ce fichier contient tous les secrets de l'appliance.
#  Préférez la console web ou seedbox-menu pour le modifier.
# =============================================================================

# --- Identité des processus et fuseau horaire --------------------------------
PUID=1000
PGID=1000
TZ=Europe/Paris
UMASK=002

# --- Chemins sur l'hôte ------------------------------------------------------
CONFIG_DIR=@@BASE@@/config
DATA_DIR=@@STORAGE@@
# Dossier des piles de Dockge : la pile « seedbox » (@@BASE@@) y figure, vos autres piles à côté
STACKS_DIR=@@STACKS@@

# --- Publication -------------------------------------------------------------
# Applications servies par chemin : https://<adresse>/sonarr/, https://<adresse>/console/...
# DOMAIN_MODE=auto : adresse principale = IP du serveur, suivie automatiquement.
# DOMAIN_MODE=custom : DOMAIN est votre nom (DNS) ; ACME_EMAIL active Let's Encrypt.
# PUBLIC_HOSTS : toutes les adresses acceptées (IP, nom complet du serveur, domaine),
# calculées par seedboxctl.
DOMAIN_MODE=auto
DOMAIN=
PUBLIC_HOSTS=
# Adresses supplémentaires (alias DNS...), séparées par des virgules ; gérées depuis la console
EXTRA_HOSTS=
# Accès distant : Tailscale (profil tailscale) et Let's Encrypt par DNS
TAILSCALE_HOSTNAME=seedbox
TAILSCALE_AUTHKEY=
TAILSCALE_DNSNAME=
ACME_DNS_PROVIDER=
ACME_EMAIL=

# --- Compte administrateur principal -----------------------------------------
# Mot de passe choisi dans l'assistant de premier démarrage (jamais écrit ici).
# ADMIN_INITIAL_PASSWORD : amorçage de p2p-aggregator, effacé après le déploiement.
ADMIN_USER=admin
ADMIN_INITIAL_PASSWORD=__AUTO__

# --- Comptes de service et clés API (générés au premier démarrage) -----------
QBIT_USERNAME=admin
QBIT_PASSWORD=__AUTO__
RADARR_API_KEY=__AUTO__
SONARR_API_KEY=__AUTO__
PROWLARR_API_KEY=__AUTO__
JACKETT_API_KEY=__AUTO__
JELLYFIN_API_KEY=
SEERR_API_KEY=
AUTHELIA_SESSION_SECRET=__AUTO__
AUTHELIA_STORAGE_KEY=__AUTO__
AUTHELIA_JWT_SECRET=__AUTO__
AUTHELIA_REDIS_PASSWORD=__AUTO__
# Double authentification : none, admins (groupe admins) ou all (tous les comptes)
AUTH_2FA=none
AUTOBRR_SESSION_SECRET=__AUTO__
AUTOBRR_ADMIN_PASSWORD=__AUTO__
CONSOLE_PROXY_SECRET=__AUTO__
P2P_JWT_SECRET=__AUTO__
P2P_CREDENTIAL_KEY=__AUTO__
P2P_SERVICE_PASSWORD=__AUTO__
P2P_SESSION_API_KEY=__AUTO__

# --- qBittorrent : accès direct ou VPN (gluetun) -----------------------------
# COMPOSE_PROFILES : « direct » (par défaut) fait tourner qBittorrent sans VPN, port de partage
# QBIT_PEER_PORT publié ; « vpn » le place dans le tunnel gluetun (console > VPN). Un seul des deux.
# autoupdate : Watchtower (mises à jour automatiques des applications, réglées dans la console).
COMPOSE_PROFILES=autoupdate,direct
QBIT_PEER_PORT=6881
# Planification de Watchtower (cron à six champs), tenue à jour par la console
WATCHTOWER_SCHEDULE=0 0 3 * * *
VPN_SERVICE_PROVIDER=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
SERVER_COUNTRIES=
# Fournisseur « custom » uniquement
WIREGUARD_ENDPOINT_IP=
WIREGUARD_ENDPOINT_PORT=
WIREGUARD_PUBLIC_KEY=
# Redirection de port : indispensable au ratio. Compatible avec protonvpn,
# private internet access et privatevpn.
VPN_PORT_FORWARDING=off

# Catalogue d'applications : adresse (https) d'un fichier JSON publié par vos soins ; vide = aucune
CATALOG_URL=
